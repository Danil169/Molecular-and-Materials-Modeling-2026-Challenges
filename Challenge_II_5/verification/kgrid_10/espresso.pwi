&CONTROL
   calculation      = 'scf'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'kgrid_10'
   pseudo_dir       = '/home/danil/home/Molecular-and-Materials-Modeling-2026-Challenges/pseudopotentials'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 50
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   ntyp             = 1
   nat              = 1
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
