&CONTROL
   calculation      = 'nscf'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'k20'
   pseudo_dir       = '/home/danil/home/Molecular-and-Materials-Modeling-2026-Challenges/pseudopotentials'
/
&SYSTEM
   ibrav            = 0
   nbnd             = 12
   ecutwfc          = 100
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   assume_isolated  = '2D'
   ntyp             = 1
   nat              = 2
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
